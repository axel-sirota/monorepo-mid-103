{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(docker compose:*)",
      "Bash(docker:*)",
      "Bash(./mvnw:*)",
      "Bash(uv:*)",
      "Bash(go:*)",
      "Bash(git:*)",
      "Bash(npm:*)",
      "Bash(terraform:*)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit:*)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/engineer-check.sh"
          },
          {
            "type": "command",
            "if": "Bash(git commit:*)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/designer-check.sh"
          },
          {
            "type": "command",
            "if": "Bash(git commit:*)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pm-check.sh"
          },
          {
            "type": "command",
            "if": "Bash(git commit:*)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/data-scientist-check.sh"
          },
          {
            "type": "command",
            "if": "Bash(git commit:*)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/devops-check.sh"
          }
        ]
      }
    ]
  }
}
