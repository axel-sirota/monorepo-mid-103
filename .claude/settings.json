{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(docker compose:*)",
      "Bash(docker:*)",
      "Bash(./mvnw:*)",
      "Bash(uv:*)",
      "Bash(go:*)",
      "Bash(git:*)",
      "Bash(npm:*)",
      "Bash(terraform:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(DROP TABLE:*)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "PreToolUse": []
  }
}
