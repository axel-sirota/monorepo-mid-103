# Inputs for module {{MODULE_NAME}}.
#
# Every variable MUST have a description and a type.

variable "environment" {
  description = "Deployment environment (dev, staging, prod) for {{MODULE_NAME}}"
  type        = string
  default     = "dev"
}

variable "name" {
  description = "Name of this {{MODULE_NAME}} instance (used in resource naming + tags)"
  type        = string
}

variable "tags" {
  description = "Additional resource tags applied to all {{MODULE_NAME}} resources"
  type        = map(string)
  default     = {}
}
