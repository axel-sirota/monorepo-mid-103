# PostgreSQL
POSTGRES_USER=monorepo
POSTGRES_PASSWORD=monorepo
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Mailhog (email sink)
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# MLflow
MLFLOW_PORT=5000

# Service ports
USER_SERVICE_PORT=8001
NOTIFICATION_SERVICE_PORT=8002
API_GATEWAY_PORT=8080
MODEL_SERVING_PORT=9001
INFERENCE_GATEWAY_PORT=9000

# API keys (change these in production!)
INFERENCE_API_KEY=dev-key-change-me
API_GATEWAY_KEY=dev-key-change-me

# Logging
LOG_LEVEL=INFO
