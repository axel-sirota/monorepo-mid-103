{
  "mcpServers": {
    "figma": {
      "_note": "Requires Figma desktop running locally + FIGMA_ACCESS_TOKEN.",
      "command": "npx",
      "args": ["-y", "figma-developer-mcp"],
      "env": {"FIGMA_ACCESS_TOKEN": "${FIGMA_ACCESS_TOKEN}"}
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    }
  }
}
